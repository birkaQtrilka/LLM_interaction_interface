{
  "families": [
    {
      "mode": "expect",
      "label": "go to SpotA",
      "prompts": [
        "Go to SpotA",
        "Walk to spot a",
        "Move to SpotA"
      ],
      "expect": [
        { "name": "moveTo", "parameters": ["SpotA"] }
      ]
    },
    {
      "mode": "expect",
      "label": "go to the chair",
      "prompts": [
        "Go to the chair",
        "Walk to the chair",
        "Move to the chair"
      ],
      "expect": [
        { "name": "moveTo", "parameters": ["Chair"] }
      ]
    },
    {
      "mode": "expect",
      "label": "grab the phone",
      "prompts": [
        "pick up the phone",
        "bring the phone",
        "grab the phone"
      ],
      "expect": [
        { "name": "moveTo", "parameters": ["phone"] },
        { "name": "grab", "parameters": ["phone"], "after": [0] }
      ]
    },
    {
      "mode": "expect",
      "label": "grab the brick",
      "prompts": [
        "pick up the brick",
        "bring the brick",
        "grab the brick"
      ],
      "expect": [
        { "name": "moveTo", "parameters": ["Brick"] },
        { "name": "grab", "parameters": ["Brick"], "after": [0] }
      ]
    },
    {
      "mode": "expect",
      "label": "phone on Table",
      "prompts": [
        "place the phone on Table",
        "put the phone on Table",
        "set the phone down on Table"
      ],
      "expect": [
        { "name": "moveTo", "parameters": ["phone"] },
        { "name": "grab", "parameters": ["phone"], "after": [0] },
        { "name": "moveTo", "parameters": ["Table"], "after": [1] },
        { "name": "place", "parameters": ["Table"], "after": [2] }
      ]
    },
    {
      "mode": "expect",
      "label": "greet",
      "prompts": [
        "Say hello",
        "Say hi",
        "Greet me"
      ],
      "expect": [
        { "name": "talk" }
      ]
    },
    {
      "mode": "expect",
      "label": "three spots in order",
      "prompts": [
        "Go to SpotC, then SpotA, then SpotB",
        "Visit SpotC first, SpotA second, and SpotB last"
      ],
      "expect": [
        { "name": "moveTo", "parameters": ["SpotC"] },
        { "name": "moveTo", "parameters": ["SpotA"], "after": [0] },
        { "name": "moveTo", "parameters": ["SpotB"], "after": [1] }
      ]
    },
    {
