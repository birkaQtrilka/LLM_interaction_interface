<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="UserTestHud.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="hud">
            <ui:Label name="step-label" text="1 / 7" class="step" />
            <ui:Label name="instruction" text="Say hi to the nurse" class="instruction" />
            <ui:Label name="status" text="" class="status" />
        </ui:VisualElement>
        <ui:VisualElement name="complete" class="complete hidden">
            <ui:Label name="complete-label" text="Tutorial complete" class="complete-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
